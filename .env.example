# Copy to .env.local and fill in.

# Your project's API key, from the console: Project → API keys.
PINE_SANDBOX_ENDPOINT=https://pinesandbox.io
PINE_SANDBOX_API_KEY=pk_...

# Encrypts the Computer's credentials, binding and session token at rest in .data/.
# Generate one with: openssl rand -base64 32
STARTER_SECRET=
