# Copy to .env.local and fill in.

# Your project's endpoint and API key, from the console: Project → API keys.
PINE_SANDBOX_ENDPOINT=https://pinesandbox.io
PINE_SANDBOX_API_KEY=pk_...

# Encrypts the Computer's credentials, binding, session tokens and vault at rest.
# Generate one with: openssl rand -base64 32
STARTER_SECRET=

# Optional: where the app keeps its records and copied files (default .data/).
# STARTER_DATA_DIR=

# Optional: drive a session with your own model.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
